# ======================= Django =======================
# SECRET_KEY: genera una con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ======================= Base de datos =======================
# Si DB_NAME está vacío se usa SQLite (desarrollo sin MySQL).
# Para MySQL: completá las variables y creá la base con:
#   CREATE DATABASE tu_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# ======================= CORS (frontend estático) =======================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ======================= JWT =======================
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7